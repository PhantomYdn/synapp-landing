{
  "name": "synapp-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && vite build --ssr src/entry-server.ts --outDir .prerender --emptyOutDir && node scripts/prerender.mjs && vitepress build docs && node scripts/generate-sitemap.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:seo": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-i18n": "^9.13.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "~5.4.0",
    "vite": "^6.4.2",
    "vitepress": "^1.6.4",
    "vue-tsc": "^1.8.0",
    "@vue/server-renderer": "^3.5.32"
  }
}
