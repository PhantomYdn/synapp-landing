# Gauze -- environment variables
#
# These are the ONLY settings that live outside the admin frontend: the
# login credential (must exist before anyone can log in to change anything
# else) and deployment wiring that can't sensibly be an admin-UI toggle.
# Everything else (retry interval, rate limit, max payload, captcha
# secret/difficulty/TTL, session length, sweep interval, accent color) is
# configured from /admin/settings after the app starts and is persisted in
# the bbolt `settings` bucket.
#
# Copy this file to `.env` and fill in real values, or supply the same
# names via Docker Compose's `environment:` / `env_file:` directives --
# both land in the real process environment the same way.

# Required. No default -- the app refuses to start without these.
GAUZE_ADMIN_USERNAME=admin
GAUZE_ADMIN_PASSWORD=admin

# Optional. Defaults shown.
GAUZE_DB_PATH=gauze.db
GAUZE_COOKIE_NAME=gauze_session
